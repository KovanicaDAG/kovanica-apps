{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kovanica Node",
  "version": "0.2.0",
  "identifier": "online.kovanica.node",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5175",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kovanica Node",
        "width": 1000,
        "height": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "category": "Utility",
    "shortDescription": "Local supervisor for one external kovanica-node and a read-only loopback monitor.",
    "publisher": "Kovanica Team <KovanicaDAG@protonmail.com>",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.36)",
          "libgcc-s1",
          "libglib2.0-0",
          "libgtk-3-0",
          "libgdk-pixbuf-2.0-0",
          "libcairo2",
          "libdbus-1-3",
          "libx11-6",
          "libwebkit2gtk-4.1-0",
          "libjavascriptcoregtk-4.1-0",
          "libsoup-3.0-0"
        ]
      }
    }
  }
}
